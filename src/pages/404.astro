---
import { localePath, t } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

// GitHub Pages は /404.html を全言語共通で返すので、日英を並べて表示する。
const ja = t('ja');
const en = t('en');
---

<BaseLayout lang="ja" title={ja('notfound.title')} alternates={{}}>
  <section class="container-site py-28 text-center sm:py-40">
    <p class="display text-gradient text-[clamp(5rem,20vw,12rem)]">404</p>
    <h1 class="display-ja mt-4 text-3xl text-fg sm:text-4xl">{ja('notfound.title')}</h1>
    <p class="mt-3 text-fg-2">{ja('notfound.body')}</p>
    <p class="display mt-10 text-2xl text-fg" lang="en">
      {en('notfound.title')}
    </p>
    <p class="mt-2 text-fg-2" lang="en">
      {en('notfound.body')}
    </p>
    <div class="mt-12 flex flex-wrap justify-center gap-3">
      <a href={localePath('ja', '/')} class="btn btn-primary">
        {ja('notfound.home')}
      </a>
      <a href={localePath('en', '/')} class="btn btn-ghost" lang="en" hreflang="en">
        {en('notfound.home')}
      </a>
    </div>
  </section>
</BaseLayout>
