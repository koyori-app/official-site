---
import { localePath, t } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

// GitHub Pages は /404.html を全言語共通で返すので、日英を並べて表示する。
const ja = t('ja');
const en = t('en');
---

<BaseLayout lang="ja" title={ja('notfound.title')} alternates={{}}>
  <section class="container-site py-24 text-center sm:py-32">
    <p class="text-7xl font-bold tracking-tight text-accent-hover">404</p>
    <h1 class="mt-6 text-3xl font-bold tracking-tight text-ink">{ja('notfound.title')}</h1>
    <p class="mt-3 text-ink-secondary">{ja('notfound.body')}</p>
    <p class="mt-8 text-2xl font-bold text-ink" lang="en">
      {en('notfound.title')}
    </p>
    <p class="mt-2 text-ink-secondary" lang="en">
      {en('notfound.body')}
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href={localePath('ja', '/')} class="btn btn-primary">
        {ja('notfound.home')}
      </a>
      <a href={localePath('en', '/')} class="btn btn-ghost" lang="en" hreflang="en">
        {en('notfound.home')}
      </a>
    </div>
  </section>
</BaseLayout>
