---
import { localePath, t } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

// GitHub Pages は /404.html を全言語共通で返すので、日英を並べて表示する。
const ja = t('ja');
const en = t('en');
---

<BaseLayout lang="ja" title={ja('notfound.title')} alternates={{}}>
  <section class="container-site grid items-center gap-12 pt-16 sm:pt-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <div>
      <p class="meta">404 · {ja('notfound.eyebrow')}</p>
      <h1 class="display-ja page-title mt-3 text-ink">{ja('notfound.title')}</h1>
      <p class="mt-4 text-lg leading-7 text-ink-2">{ja('notfound.body')}</p>
      <div lang="en" class="mt-10 border-t border-line-strong pt-8">
        <p class="meta">404 · {en('notfound.eyebrow')}</p>
        <p class="display section-title mt-3 text-ink">{en('notfound.title')}</p>
        <p class="mt-3 text-lg leading-7 text-ink-2">{en('notfound.body')}</p>
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={localePath('ja', '/')} class="btn btn-primary">
          {ja('notfound.home')}
        </a>
        <a href={localePath('en', '/')} class="btn btn-secondary" lang="en" hreflang="en">
          {en('notfound.home')}
        </a>
      </div>
    </div>
    <svg
      class="mx-auto w-full max-w-[32rem]"
      viewBox="-10 30 560 260"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <pattern
          id="twist"
          width="14"
          height="14"
          patternUnits="userSpaceOnUse"
          patternTransform="rotate(-58)"
        >
          <rect width="14" height="14" fill="#c4b5df"></rect>
          <rect width="5" height="14" fill="#5f7a66"></rect>
        </pattern>
      </defs>
      <path
        d="M-10 70 C 90 60 150 120 214 170"
        fill="none"
        stroke="url(#twist)"
        stroke-width="20"
      ></path>
      <g stroke-linecap="round" fill="none" stroke-width="3">
        <path d="M214 170 q 14 6 22 2" stroke="#c4b5df"></path>
        <path d="M214 170 q 10 12 24 14" stroke="#9fc2a9"></path>
        <path d="M214 170 q 4 16 10 24" stroke="#6e5c8f"></path>
        <path d="M214 170 q 16 -4 26 -14" stroke="#5f7a66"></path>
      </g>
      <path
        d="M530 250 C 430 250 360 220 300 204"
        fill="none"
        stroke="url(#twist)"
        stroke-width="20"
      ></path>
      <g stroke-linecap="round" fill="none" stroke-width="3">
        <path d="M300 204 q -14 -8 -24 -4" stroke="#c4b5df"></path>
        <path d="M300 204 q -10 -12 -22 -12" stroke="#9fc2a9"></path>
        <path d="M300 204 q -6 10 -16 14" stroke="#6e5c8f"></path>
        <path d="M300 204 q -16 4 -24 14" stroke="#5f7a66"></path>
      </g>
    </svg>
  </section>
</BaseLayout>
