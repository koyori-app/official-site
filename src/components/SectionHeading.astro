---
interface Props {
  id?: string;
  index?: string;
  eyebrow: string;
  title: string;
  lead?: string;
  lang?: 'ja' | 'en';
}
const { id, index, eyebrow, title, lead, lang = 'ja' } = Astro.props;
---

<div class="max-w-3xl">
  <p class="label-mono flex items-center gap-3">
    {index && <span class="text-sage">{index}</span>}
    <span>{eyebrow}</span>
  </p>
  <h2
    id={id}
    class:list={[
      'mt-4 text-4xl text-fg sm:text-5xl lg:text-6xl',
      lang === 'ja' ? 'display-ja' : 'display',
    ]}
  >
    {title}
  </h2>
  {lead && <p class="mt-5 max-w-xl text-lg text-fg-2">{lead}</p>}
</div>
