---
interface Props {
  id?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
}
const { id, title, lead, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <h2 id={id} class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
    {title}
  </h2>
  {lead && <p class="mt-3 text-lg text-ink-secondary">{lead}</p>}
</div>
