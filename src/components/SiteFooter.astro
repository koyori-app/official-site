---
import type { Locale } from '../i18n/ui';
import { localePath, t } from '../i18n/utils';
import { githubOrg, products } from '../data/products';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);

const siteLinks = [
  { href: localePath(lang, '/products/'), label: tr('nav.products') },
  { href: localePath(lang, '/news/'), label: tr('nav.news') },
  { href: localePath(lang, '/about/'), label: tr('nav.about') },
  { href: githubOrg, label: tr('nav.github'), external: true },
];
---

<footer class="sumi-sheet no-bottom on-sumi mt-32">
  <div class="container-site grid gap-14 pt-20 pb-14 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)_minmax(0,1fr)]">
    <div class="flex items-start gap-6">
      <p class="footer-word" lang="ja" aria-hidden="true">
        紙縒り
      </p>
      <div>
        <p class="footer-mark">Koyori</p>
        <p class="mt-5 max-w-sm text-on-sumi">{tr('footer.tagline')}</p>
        <p class="mt-3 max-w-sm text-sm text-on-sumi-2">{tr('footer.meaning')}</p>
      </div>
    </div>
    <nav aria-labelledby="footer-products">
      <h2 id="footer-products" class="label-mono text-on-sumi-2">
        {tr('footer.products')}
      </h2>
      <ul class="mt-5 flex flex-col gap-1">
        {products.map((product) => (
          <li>
            <a
              href={localePath(lang, `/products/${product.slug}`)}
              class="group inline-flex min-h-9 items-center gap-3 text-on-sumi hover:underline hover:underline-offset-4"
            >
              <span
                class="h-0.5 w-5"
                style={`background:${product.strand.color}`}
                aria-hidden="true"
              />
              {product.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-labelledby="footer-site">
      <h2 id="footer-site" class="label-mono text-on-sumi-2">
        {tr('footer.site')}
      </h2>
      <ul class="mt-5 flex flex-col gap-1">
        {siteLinks.map((link) => (
          <li>
            <a
              href={link.href}
              rel={link.external ? 'noopener' : undefined}
              class="inline-flex min-h-9 items-center text-on-sumi hover:underline hover:underline-offset-4"
            >
              {link.label}
              {link.external && <span aria-hidden="true">&nbsp;↗</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-sumi-line">
    <div class="container-site flex flex-wrap items-center justify-between gap-2 py-5">
      <p class="label-mono text-on-sumi-2">{tr('footer.rights')}</p>
      <a
        href="https://github.com/koyori-app/official-site"
        rel="noopener"
        class="label-mono inline-flex min-h-9 items-center text-on-sumi-2 hover:text-on-sumi"
      >
        Source on GitHub ↗
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-mark {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 380;
    font-size: clamp(4rem, 12vw, 9rem);
    line-height: 0.85;
    letter-spacing: -0.045em;
    background: linear-gradient(100deg, var(--koyori-lav) 10%, var(--koyori-sage) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }
  .footer-word {
    writing-mode: vertical-rl;
    font-family: var(--font-mincho);
    font-size: 1.1rem;
    letter-spacing: 0.4em;
    color: var(--koyori-on-sumi-2);
    padding-top: 0.4rem;
    border-left: 1px solid var(--koyori-sumi-line);
    padding-left: 0.6rem;
  }
</style>
