---
import type { Locale } from '../i18n/ui';
import { localePath, t } from '../i18n/utils';
import { githubOrg, products } from '../data/products';
import LogoMark from './LogoMark.astro';
import StrandMark from './StrandMark.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);

const siteLinks = [
  { href: localePath(lang, '/products/'), label: tr('nav.products') },
  { href: localePath(lang, '/news/'), label: tr('nav.news') },
  { href: localePath(lang, '/about/'), label: tr('nav.about') },
  { href: githubOrg, label: tr('nav.github'), external: true },
];
---

<footer class="mt-32 border-t border-line bg-paper-2">
  <div class="container-site grid gap-12 pt-16 pb-12 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)]">
    <div>
      <p class="flex items-center gap-2 text-ink">
        <LogoMark class="h-7 w-7" />
        <span class="text-lg leading-none font-medium">Koyori</span>
      </p>
      <p class="mt-4 max-w-sm text-ink">{tr('footer.tagline')}</p>
      <p class="mt-2 max-w-sm text-sm leading-6 text-ink-2">{tr('footer.meaning')}</p>
    </div>
    <nav aria-labelledby="footer-products">
      <h2 id="footer-products" class="text-sm text-ink-3">
        {tr('footer.products')}
      </h2>
      <ul class="mt-3 flex flex-col">
        {products.map((product) => (
          <li>
            <a
              href={localePath(lang, `/products/${product.slug}`)}
              class="inline-flex min-h-10 items-center gap-3 text-ink-2 transition-colors duration-150 hover:text-ink"
            >
              <StrandMark color={product.strand.color} />
              {product.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-labelledby="footer-site">
      <h2 id="footer-site" class="text-sm text-ink-3">
        {tr('footer.site')}
      </h2>
      <ul class="mt-3 flex flex-col">
        {siteLinks.map((link) => (
          <li>
            <a
              href={link.href}
              rel={link.external ? 'noopener' : undefined}
              class="inline-flex min-h-10 items-center gap-1 text-ink-2 transition-colors duration-150 hover:text-ink"
            >
              {link.label}
              {link.external && <Icon name="arrow-up-right" />}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="container-site flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
      <p class="meta">{tr('footer.rights')}</p>
      <a
        href="https://github.com/koyori-app/official-site"
        rel="noopener"
        class="meta inline-flex min-h-10 items-center gap-1 transition-colors duration-150 hover:text-ink"
      >
        {tr('footer.source')}
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </div>
</footer>
