---
import type { Locale } from '../i18n/ui';
import { localePath, t } from '../i18n/utils';
import { githubOrg, products } from '../data/products';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);

const siteLinks = [
  { href: localePath(lang, '/products/'), label: tr('nav.products') },
  { href: localePath(lang, '/news/'), label: tr('nav.news') },
  { href: localePath(lang, '/about/'), label: tr('nav.about') },
  { href: githubOrg, label: tr('nav.github'), external: true },
];
---

<footer class="mt-32 border-t border-line">
  <div class="container-site grid gap-12 py-16 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="display text-5xl text-fg sm:text-6xl">Koyori</p>
      <p class="mt-5 max-w-sm text-fg-2">{tr('footer.tagline')}</p>
    </div>
    <nav aria-labelledby="footer-products">
      <h2 id="footer-products" class="label-mono">
        {tr('footer.products')}
      </h2>
      <ul class="mt-5 flex flex-col gap-3">
        {products.map((product) => (
          <li>
            <a
              href={localePath(lang, `/products/${product.slug}`)}
              class="text-fg-2 transition-colors duration-150 hover:text-fg"
            >
              {product.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-labelledby="footer-site">
      <h2 id="footer-site" class="label-mono">
        {tr('footer.site')}
      </h2>
      <ul class="mt-5 flex flex-col gap-3">
        {siteLinks.map((link) => (
          <li>
            <a
              href={link.href}
              rel={link.external ? 'noopener' : undefined}
              class="text-fg-2 transition-colors duration-150 hover:text-fg"
            >
              {link.label}
              {link.external && <span aria-hidden="true"> ↗</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="container-site flex flex-wrap items-center justify-between gap-2 py-5">
      <p class="label-mono">{tr('footer.rights')}</p>
      <a
        href="https://github.com/koyori-app/official-site"
        rel="noopener"
        class="label-mono transition-colors duration-150 hover:text-fg"
      >
        Source on GitHub ↗
      </a>
    </div>
  </div>
</footer>
