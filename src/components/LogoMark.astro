---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <rect width="64" height="64" rx="16" fill="var(--koyori-color-accent)"></rect>
  <path
    d="M22 48c-2-9 4-13 10-16s12-7 10-16"
    fill="none"
    stroke="var(--koyori-color-on-accent)"
    stroke-width="6"
    stroke-linecap="round"
  ></path>
  <path
    d="M42 48c2-9-4-13-10-16s-12-7-10-16"
    fill="none"
    stroke="var(--koyori-color-sage)"
    stroke-width="6"
    stroke-linecap="round"
  ></path>
</svg>
