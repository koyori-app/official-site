---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import type { ProductStatus } from '../data/products';

interface Props {
  status: ProductStatus;
  lang: Locale;
  class?: string;
}
const { status, lang, class: className = '' } = Astro.props;
const tr = t(lang);
---

<span
  class:list={['status inline-flex items-center gap-2 whitespace-nowrap', className]}
  data-status={status}
>
  <span class="status-mark" aria-hidden="true"></span>
  <span class="sr-only">{tr('product.status')}: </span>
  {tr(`product.status.${status}`)}
</span>

<style>
  /* 状態は色ではなく形で見分ける: 公開中 = 塗り、開発中 = 輪、アルファ = 半分 */
  .status-mark {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }
  [data-status='available'] .status-mark {
    background-color: currentColor;
  }
  [data-status='alpha'] .status-mark {
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }
</style>
