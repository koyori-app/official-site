---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import type { ProductStatus } from '../data/products';

interface Props {
  status: ProductStatus;
  lang: Locale;
  class?: string;
}
const { status, lang, class: className = '' } = Astro.props;
const tr = t(lang);
const label = tr(`product.status.${status}`);
const dot: Record<ProductStatus, string> = {
  development: 'bg-accent-hover',
  available: 'bg-sage',
  alpha: 'bg-ink-muted',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-raised px-2.5 py-0.5 text-xs font-medium text-ink-secondary',
    className,
  ]}
>
  <span class:list={['h-1.5 w-1.5 rounded-full', dot[status]]} aria-hidden="true"></span>
  <span class="sr-only">{tr('product.status')}: </span>
  {label}
</span>
