---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import type { ProductStatus } from '../data/products';

interface Props {
  status: ProductStatus;
  lang: Locale;
  class?: string;
}
const { status, lang, class: className = '' } = Astro.props;
const tr = t(lang);
const dot: Record<ProductStatus, string> = {
  development: 'bg-lav',
  available: 'bg-sage',
  alpha: 'bg-fg-3',
};
---

<span class:list={['label-mono inline-flex items-center gap-2 whitespace-nowrap', className]}>
  <span class:list={['h-1.5 w-1.5 rounded-full', dot[status]]} aria-hidden="true"></span>
  <span class="sr-only">{tr('product.status')}: </span>
  {tr(`product.status.${status}`)}
</span>
