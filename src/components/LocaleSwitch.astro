---
import { localeNames, locales, type Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Locale;
  targets: Record<Locale, string>;
}
const { lang, targets } = Astro.props;
const tr = t(lang);
---

<nav aria-label={tr('locale.label')}>
  <ul class="flex items-center gap-1 rounded-full border border-line p-1">
    {locales.map((locale) => (
      <li>
        <a
          href={targets[locale]}
          hreflang={locale}
          lang={locale}
          aria-label={localeNames[locale]}
          aria-current={locale === lang ? 'true' : undefined}
          class:list={[
            'label-mono inline-flex h-7 items-center rounded-full px-2.5 transition-colors duration-150',
            locale === lang ? 'bg-fg text-bg' : 'hover:text-fg',
          ]}
        >
          {locale.toUpperCase()}
        </a>
      </li>
    ))}
  </ul>
</nav>
