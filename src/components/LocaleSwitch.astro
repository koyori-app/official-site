---
import { localeNames, locales, type Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Locale;
  targets: Record<Locale, string>;
}
const { lang, targets } = Astro.props;
const tr = t(lang);
// 2 言語なので、いま表示していない言語へのリンクを 1 つだけ置く
const others = locales.filter((locale) => locale !== lang);
---

<nav aria-label={tr('locale.label')}>
  <ul class="flex items-center">
    {others.map((locale) => (
      <li>
        <a
          href={targets[locale]}
          hreflang={locale}
          lang={locale}
          class="inline-flex min-h-10 items-center px-2 text-[0.9375rem] text-ink-2 transition-colors duration-150 hover:text-ink"
        >
          {localeNames[locale]}
        </a>
      </li>
    ))}
  </ul>
</nav>
