---
import { localeNames, locales, type Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Locale;
  targets: Record<Locale, string>;
}
const { lang, targets } = Astro.props;
const tr = t(lang);
---

<nav aria-label={tr('locale.label')}>
  <ul class="flex items-center font-mono text-xs tracking-[0.1em]">
    {locales.map((locale, i) => (
      <li class="flex items-center">
        {i > 0 && (
          <span class="px-0.5 text-ink-3" aria-hidden="true">
            /
          </span>
        )}
        <a
          href={targets[locale]}
          hreflang={locale}
          lang={locale}
          aria-label={localeNames[locale]}
          aria-current={locale === lang ? 'true' : undefined}
          class:list={[
            'inline-flex h-10 min-w-10 items-center justify-center px-1.5 uppercase transition-colors duration-150',
            locale === lang
              ? 'text-ink underline decoration-2 underline-offset-[6px]'
              : 'text-ink-3 hover:text-ink',
          ]}
        >
          {locale}
        </a>
      </li>
    ))}
  </ul>
</nav>
