---
import type { Locale } from '../i18n/ui';
import { localePath, stripLocale, t } from '../i18n/utils';
import { githubOrg } from '../data/products';
import LogoMark from './LogoMark.astro';
import LocaleSwitch from './LocaleSwitch.astro';
import MobileNav from './react/MobileNav';

interface Props {
  lang: Locale;
  switchTargets: Record<Locale, string>;
}
const { lang, switchTargets } = Astro.props;
const tr = t(lang);
const current = stripLocale(Astro.url.pathname);

const isCurrent = (path: string) => {
  const normalized = current.endsWith('/') ? current : `${current}/`;
  return path === '/' ? normalized === '/' : normalized.startsWith(path);
};

const nav = [
  { path: '/products/', label: tr('nav.products') },
  { path: '/news/', label: tr('nav.news') },
  { path: '/about/', label: tr('nav.about') },
].map((item) => ({
  href: localePath(lang, item.path),
  label: item.label,
  current: isCurrent(item.path),
}));

const mobileItems = [
  { href: localePath(lang, '/'), label: tr('nav.home'), current: isCurrent('/') },
  ...nav,
  { href: githubOrg, label: tr('nav.github'), external: true },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur-md">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a
      href={localePath(lang, '/')}
      class="group flex min-h-11 items-center gap-3 text-ink"
      aria-label={tr('site.name')}
    >
      <LogoMark class="h-7 w-7 transition-transform duration-500 ease-soft group-hover:rotate-[-12deg]" />
      <span class="font-serif text-[1.35rem] leading-none tracking-tight italic">Koyori</span>
    </a>

    <nav aria-label={tr('nav.primary')} class="hidden md:block">
      <ul class="flex items-center gap-8">
        {nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              aria-current={item.current ? 'page' : undefined}
              class:list={[
                'nav-link inline-flex min-h-10 items-center gap-2 text-sm text-ink',
                item.current && 'is-current',
              ]}
            >
              <span class="font-mono text-[0.6875rem] text-ink-3">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
        <li>
          <a
            href={githubOrg}
            rel="noopener"
            class="nav-link inline-flex min-h-10 items-center gap-1 text-sm text-ink"
          >
            {tr('nav.github')}
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LocaleSwitch lang={lang} targets={switchTargets} />
      <div class="md:hidden">
        <MobileNav
          client:media="(max-width: 767px)"
          items={mobileItems}
          labels={{ open: tr('nav.open'), close: tr('nav.close'), menu: tr('nav.menu') }}
        />
      </div>
    </div>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
  }
  /* 現在地と hover に、撚った糸の下線 */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.35rem;
    height: 3px;
    background-image: repeating-linear-gradient(
      -60deg,
      var(--koyori-lav) 0 4px,
      var(--koyori-sage-deep) 4px 6px
    );
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 360ms var(--koyori-ease);
  }
  .nav-link:hover::after,
  .nav-link.is-current::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>
