---
import type { Locale } from '../i18n/ui';
import { localePath, stripLocale, t } from '../i18n/utils';
import { githubOrg } from '../data/products';
import LogoMark from './LogoMark.astro';
import LocaleSwitch from './LocaleSwitch.astro';
import Icon from './Icon.astro';
import MobileNav from './react/MobileNav';

interface Props {
  lang: Locale;
  switchTargets: Record<Locale, string>;
}
const { lang, switchTargets } = Astro.props;
const tr = t(lang);
const current = stripLocale(Astro.url.pathname);

const isCurrent = (path: string) => {
  const normalized = current.endsWith('/') ? current : `${current}/`;
  return path === '/' ? normalized === '/' : normalized.startsWith(path);
};

const nav = [
  { path: '/products/', label: tr('nav.products') },
  { path: '/news/', label: tr('nav.news') },
  { path: '/about/', label: tr('nav.about') },
].map((item) => ({
  href: localePath(lang, item.path),
  label: item.label,
  current: isCurrent(item.path),
}));

const mobileItems = [
  { href: localePath(lang, '/'), label: tr('nav.home'), current: isCurrent('/') },
  ...nav,
  { href: githubOrg, label: tr('nav.github'), external: true },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-md">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a
      href={localePath(lang, '/')}
      class="flex min-h-11 items-center gap-2 text-ink"
      aria-label={tr('site.name')}
    >
      <LogoMark class="h-7 w-7" />
      <span class="text-lg leading-none font-medium">Koyori</span>
    </a>

    <nav aria-label={tr('nav.primary')} class="hidden md:block">
      <ul class="flex items-center gap-8 text-[0.9375rem]">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.current ? 'page' : undefined}
              class:list={[
                'nav-link inline-flex min-h-10 items-center transition-colors duration-150',
                item.current ? 'text-ink' : 'text-ink-2 hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={githubOrg}
            rel="noopener"
            class="inline-flex min-h-10 items-center gap-1 text-ink-2 transition-colors duration-150 hover:text-ink"
          >
            {tr('nav.github')}
            <Icon name="arrow-up-right" />
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LocaleSwitch lang={lang} targets={switchTargets} />
      <div class="md:hidden">
        <MobileNav
          client:media="(max-width: 767px)"
          items={mobileItems}
          labels={{ open: tr('nav.open'), close: tr('nav.close'), menu: tr('nav.menu') }}
        />
      </div>
    </div>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
  }
  /* 現在地は墨の細い下線 */
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.5rem;
    height: 1px;
    background-color: var(--koyori-ink);
  }
</style>
