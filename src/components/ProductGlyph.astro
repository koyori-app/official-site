---
import type { ProductSlug } from '../data/products';

interface Props {
  slug: ProductSlug;
  class?: string;
}
const { slug, class: className = 'h-16 w-16' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  data-glyph={slug}
>
  {slug === 'task' && (
    <>
      <rect x="10" y="10" width="12" height="12" rx="3" />
      <path d="M13.5 16l2.5 2.5 4.5-5" class="glyph-accent" />
      <path d="M28 16h26" />
      <rect x="10" y="26" width="12" height="12" rx="3" />
      <path d="M13.5 32l2.5 2.5 4.5-5" class="glyph-accent" />
      <path d="M28 32h18" />
      <rect x="10" y="42" width="12" height="12" rx="3" />
      <path d="M28 48h22" stroke-dasharray="2 3" />
    </>
  )}
  {slug === 'vrt' && (
    <>
      <rect x="8" y="14" width="48" height="36" rx="4" />
      <path d="M32 14v36" class="glyph-accent" />
      <path d="M14 24h10M14 30h7M14 36h12" />
      <path d="M40 24h10M40 30h7M40 36h4" />
      <rect
        x="44"
        y="34"
        width="8"
        height="6"
        rx="1"
        class="glyph-accent"
        fill="currentColor"
        fill-opacity="0.25"
      />
      <path d="M29 10l3 4 3-4" class="glyph-accent" />
    </>
  )}
  {slug === 'ui' && (
    <>
      <rect x="8" y="10" width="30" height="12" rx="6" />
      <circle cx="16" cy="16" r="3" class="glyph-accent" fill="currentColor" fill-opacity="0.4" />
      <rect x="44" y="10" width="12" height="12" rx="3" />
      <path d="M47 16l2.5 2.5 4-4.5" class="glyph-accent" />
      <rect x="8" y="30" width="48" height="10" rx="2" />
      <path d="M12 35h20" />
      <circle cx="50" cy="35" r="1.5" fill="currentColor" />
      <rect
        x="8"
        y="46"
        width="22"
        height="10"
        rx="5"
        class="glyph-accent"
        fill="currentColor"
        fill-opacity="0.18"
      />
      <path d="M36 51h20" />
    </>
  )}
  {slug === 'arc' && (
    <>
      <rect x="8" y="14" width="18" height="6" rx="3" fill="currentColor" fill-opacity="0.25" />
      <rect x="22" y="28" width="22" height="6" rx="3" fill="currentColor" fill-opacity="0.25" />
      <rect x="38" y="42" width="18" height="6" rx="3" fill="currentColor" fill-opacity="0.25" />
      <path d="M26 17c6 0 6 14 10 14" class="glyph-accent" />
      <path d="M44 31c6 0 6 14 8 14" class="glyph-accent" />
      <path d="M8 56h48" stroke-dasharray="1.5 3" />
    </>
  )}
</svg>

<style>
  .glyph-accent {
    stroke: var(--koyori-sage);
  }
</style>
