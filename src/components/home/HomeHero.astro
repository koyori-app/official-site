---
import type { Locale } from '../../i18n/ui';
import { localePath, t } from '../../i18n/utils';
import { githubOrg, products } from '../../data/products';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);
const strands = JSON.stringify(products.map((p) => p.strand.color));
---

<section
  class="hero relative isolate overflow-hidden"
  data-koyori-hero
  data-strands={strands}
  aria-labelledby="hero-title"
>
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <canvas class="hero-canvas block h-full w-full"></canvas>
    <svg
      class="hero-fallback absolute inset-0 h-full w-full"
      viewBox="0 0 1000 600"
      preserveAspectRatio="none"
      focusable="false"
    >
      <path
        d="M-40 150 C 200 210 420 260 760 380"
        fill="none"
        stroke="var(--koyori-lav)"
        stroke-width="22"
        stroke-linecap="round"
      ></path>
      <path
        d="M-40 150 C 200 210 420 260 760 380"
        fill="none"
        stroke="var(--koyori-sage-deep)"
        stroke-width="22"
        stroke-dasharray="10 14"
      ></path>
      {products.map((p, i) => (
        <path
          d={`M760 380 C 900 430 ${125 + i * 250} 480 ${125 + i * 250} 620`}
          fill="none"
          stroke={p.strand.color}
          stroke-width="4"
        />
      ))}
    </svg>
  </div>

  <div class="hero-grid container-site">
    <p class="hero-eyebrow label-mono">
      <span class="text-ink">Koyori</span> — {tr('hero.eyebrow')}
    </p>

    <p class="hero-word" lang="ja">
      <span class="hero-word-kanji">{tr('hero.word')}</span>
      <span class="hero-word-reading label-mono" lang="en">
        {tr('hero.reading')}
      </span>
      <span class="hero-word-meaning" lang={lang}>
        {tr('hero.meaning')}
      </span>
    </p>

    <div class="hero-title-wrap">
      <span class="anchor anchor-start" data-gl-anchor="start"></span>
      <span class="anchor anchor-split" data-gl-anchor="split"></span>
      <h1 id="hero-title" class:list={['hero-title', `hero-title-${lang}`]}>
        <span class="hero-line">
          <span data-gl-text>{tr('hero.title.1')}</span>
        </span>
        <span class="hero-line hero-line-2">
          <span data-gl-text>{tr('hero.title.2')}</span>
        </span>
      </h1>
    </div>

    <div class="hero-lead">
      <p class="text-ink-2">{tr('hero.lead')}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={localePath(lang, '/products/')} class="btn btn-primary">
          {tr('hero.cta.products')}
          <span aria-hidden="true">→</span>
        </a>
        <a href={githubOrg} rel="noopener" class="btn btn-ghost">
          {tr('hero.cta.github')}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <ol class="hero-exits" aria-label={tr('products.title')}>
      {products.map((product, i) => (
        <li class="hero-exit">
          <span class="exit-anchor" data-gl-exit />
          <a href={localePath(lang, `/products/${product.slug}`)} class="hero-exit-link">
            <span class="text-ink-3">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-ink">{product.name.replace('Koyori ', '')}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>

  <span class="mobile-exits" aria-hidden="true">
    {products.map((_, i) => (
      <span class="mobile-exit" style={`--i: ${i}`} data-gl-exit />
    ))}
  </span>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-koyori-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('.hero-canvas');
  if (hero && canvas) {
    const fail = () => {
      hero.dataset.gl = 'fallback';
    };
    const start = () => {
      import('../../scripts/koyori/scene')
        .then(({ mount }) => {
          try {
            const dispose = mount(hero, canvas);
            document.addEventListener('astro:before-swap', dispose, { once: true });
          } catch {
            fail();
          }
        })
        .catch(fail);
    };
    const probe = document.createElement('canvas');
    const supported = !!(probe.getContext('webgl2') || probe.getContext('webgl'));
    if (!supported) {
      fail();
    } else if ('requestIdleCallback' in window) {
      window.requestIdleCallback(start, { timeout: 900 });
    } else {
      setTimeout(start, 120);
    }
  }
</script>

<style>
  .hero {
    --mobile-spine: calc(var(--gutter) * 0.5);
    background-color: var(--koyori-paper);
  }

  .hero-fallback {
    display: none;
  }
  :global(html:not(.js)) .hero-fallback,
  .hero[data-gl='fallback'] .hero-fallback {
    display: block;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: calc(100svh - 4rem);
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    row-gap: 1.5rem;
    align-content: start;
  }

  .hero-eyebrow {
    max-width: 24rem;
  }

  /* 辞書の見出し語のような「紙縒り」 */
  .hero-word {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.9rem;
    align-items: baseline;
    max-width: 20rem;
  }
  .hero-word-kanji {
    font-family: var(--font-mincho);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }
  .hero-word-reading {
    color: var(--koyori-lav-ink);
  }
  .hero-word-meaning {
    grid-column: 1 / -1;
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--koyori-ink-2);
  }

  .hero-title-wrap {
    position: relative;
    margin-top: 2.5rem;
  }
  .hero-title {
    --gl-ink: var(--koyori-ink);
    color: var(--gl-ink);
    font-family: var(--font-serif);
    font-weight: 440;
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-feature-settings: normal;
  }
  .hero-title-ja {
    font-family: var(--font-mincho);
    font-weight: 560;
    letter-spacing: 0.02em;
    font-size: clamp(2.5rem, 11.4vw, 9rem);
  }
  .hero-title-en {
    font-size: clamp(2.6rem, 11.2vw, 8.6rem);
    letter-spacing: -0.035em;
  }
  .hero-line {
    display: block;
    white-space: nowrap;
  }
  .hero-line > span {
    display: inline-block;
  }
  .hero-line-2 {
    --gl-ink: var(--koyori-lav-ink);
    padding-left: 0.55em;
  }
  .hero-title-en .hero-line-2 {
    font-style: italic;
    padding-left: 0.6em;
  }
  .hero[data-gl='ready'] [data-gl-text] {
    color: transparent;
  }

  .anchor {
    position: absolute;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  /* スマートフォン: 右上から入り、見出しを斜めに横切って左の余白へ降りる */
  .anchor-start {
    right: calc(-1 * var(--gutter) - 22vw);
    top: 8%;
  }
  .anchor-split {
    left: calc(var(--mobile-spine) - var(--gutter) + 12px);
    top: calc(100% + 2.5rem);
  }

  .hero-lead {
    position: relative;
    padding-left: 2.6rem;
    margin-top: 2.5rem;
  }
  .hero-lead p {
    max-width: 32rem;
    font-size: 1rem;
    line-height: 1.9;
  }

  .hero-exits {
    display: none;
  }
  .mobile-exits {
    position: absolute;
    left: 0;
    bottom: 0;
  }
  .mobile-exit {
    position: absolute;
    bottom: 0;
    left: calc(var(--mobile-spine) + var(--i) * 7px);
    width: 1px;
    height: 1px;
  }

  @media (width >= 48rem) {
    .hero-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      grid-template-rows: auto auto auto 1fr auto;
      padding-top: 2rem;
      padding-bottom: 0;
      row-gap: 0;
    }
    .hero-eyebrow {
      grid-column: 1 / 7;
      grid-row: 1;
    }
    .hero-word {
      grid-column: 9 / 13;
      grid-row: 1;
      justify-self: end;
    }
    .hero-title-wrap {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: clamp(1rem, 5vh, 3.5rem);
    }
    .hero-title-ja {
      font-size: clamp(3rem, 8.6vw, 8.75rem);
    }
    .hero-title-en {
      font-size: clamp(3rem, 8.4vw, 8.5rem);
    }
    .hero-line-2 {
      padding-left: 1.35em;
    }
    .hero-title-en .hero-line-2 {
      padding-left: 1.1em;
    }
    /* デスクトップ: 左の外から入り、見出しを右下へ縫って、右寄りでほどける */
    .anchor-start {
      left: calc(-1 * var(--gutter) - 12vw);
      right: auto;
      top: -22%;
    }
    .anchor-split {
      left: 84%;
      top: calc(100% + 4.5rem);
    }
    .hero-lead {
      grid-column: 1 / 7;
      grid-row: 3;
      padding-left: 0;
      margin-top: 2rem;
    }
    .hero-exits {
      grid-column: 1 / -1;
      grid-row: 5;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 2rem;
      padding-top: 2.5rem;
    }
    .hero-exit {
      position: relative;
      padding-bottom: 1.25rem;
    }
    .exit-anchor {
      position: absolute;
      left: 50%;
      bottom: 0;
      width: 1px;
      height: 1px;
    }
    .hero-exit-link {
      display: inline-flex;
      gap: 0.6rem;
      margin-left: calc(50% + 1.75rem);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      padding-block: 0.4rem;
      border-bottom: 1px solid transparent;
      transition: border-color 200ms var(--koyori-ease);
    }
    .hero-exit-link:hover {
      border-bottom-color: currentColor;
    }
    .mobile-exits {
      display: none;
    }
  }

  @media (width >= 64rem) {
    .hero-lead {
      grid-column: 1 / 6;
    }
  }
</style>
