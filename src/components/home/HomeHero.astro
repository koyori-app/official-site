---
import type { Locale } from '../../i18n/ui';
import { localePath, t } from '../../i18n/utils';
import { githubOrg, products } from '../../data/products';
import Icon from '../Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);
const strands = JSON.stringify(products.map((p) => p.strand.color));
---

<section
  class="hero relative isolate overflow-hidden"
  data-koyori-hero
  data-strands={strands}
  aria-labelledby="hero-title"
>
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <canvas class="hero-canvas block h-full w-full"></canvas>
    <!-- WebGL が使えないときの紐。デスクトップとスマートフォンで構図が違うので 2 枚 -->
    <svg
      class="hero-fallback hero-fallback-wide absolute inset-0 h-full w-full"
      viewBox="0 0 1000 600"
      preserveAspectRatio="none"
      focusable="false"
    >
      <g fill="none">
        <path
          d="M1080 24 C 900 180 760 300 600 444"
          stroke="var(--koyori-lav)"
          stroke-width="22"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        ></path>
        <path
          d="M1080 24 C 900 180 760 300 600 444"
          stroke="var(--koyori-sage-deep)"
          stroke-width="22"
          stroke-dasharray="10 14"
          vector-effect="non-scaling-stroke"
        ></path>
        {products.map((p, i) => (
          <path
            d={`M600 444 C 520 520 ${55 + i * 240} 520 ${55 + i * 240} 620`}
            stroke={p.strand.color}
            stroke-width="4"
            vector-effect="non-scaling-stroke"
          />
        ))}
      </g>
    </svg>
    <svg
      class="hero-fallback hero-fallback-narrow absolute inset-0 h-full w-full"
      viewBox="0 0 390 780"
      preserveAspectRatio="none"
      focusable="false"
    >
      <g fill="none">
        <path
          d="M440 470 C 300 560 160 640 44 700"
          stroke="var(--koyori-lav)"
          stroke-width="16"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        ></path>
        <path
          d="M440 470 C 300 560 160 640 44 700"
          stroke="var(--koyori-sage-deep)"
          stroke-width="16"
          stroke-dasharray="8 10"
          vector-effect="non-scaling-stroke"
        ></path>
        {products.map((p, i) => (
          <path
            d={`M44 700 C 44 730 ${44 + i * 8} 740 ${44 + i * 8} 800`}
            stroke={p.strand.color}
            stroke-width="3"
            vector-effect="non-scaling-stroke"
          />
        ))}
      </g>
    </svg>
  </div>

  <div class="hero-body container-site">
    <div class="hero-text">
      <h1 id="hero-title" class:list={['hero-title', lang === 'ja' ? 'display-ja' : 'display']}>
        <span class="block">{tr('hero.title.1')}</span>
        <span class="block">{tr('hero.title.2')}</span>
      </h1>
      <p class="hero-lead">{tr('hero.lead')}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={localePath(lang, '/products/')} class="btn btn-primary">
          {tr('hero.cta.products')}
          <Icon name="arrow-right" />
        </a>
        <a href={githubOrg} rel="noopener" class="btn btn-secondary">
          {tr('hero.cta.github')}
          <Icon name="arrow-up-right" />
        </a>
      </div>
    </div>
  </div>

  <!-- 紐の舞台。デスクトップではヒーロー全体、スマートフォンでは本文の下の帯 -->
  <div class="hero-stage">
    <span class="anchor anchor-start" data-gl-anchor="start"></span>
    <span class="anchor anchor-split" data-gl-anchor="split"></span>
    <p class="hero-caption">
      <span class="hero-caption-word" lang="ja">
        {tr('hero.word')}
      </span>
      <span class="text-ink-3" lang={lang === 'ja' ? 'ja' : 'en'}>
        {tr('hero.reading')}
      </span>
      <span class="hero-caption-meaning">{tr('hero.meaning')}</span>
    </p>
  </div>

  <div class="hero-exits container-site" aria-hidden="true">
    {products.map((_, i) => (
      <span class="hero-exit" style={`--i: ${i}`} data-gl-exit />
    ))}
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-koyori-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('.hero-canvas');
  if (hero && canvas) {
    const fail = () => {
      hero.dataset.gl = 'fallback';
    };
    const start = () => {
      import('../../scripts/koyori/scene')
        .then(({ mount }) => {
          try {
            const dispose = mount(hero, canvas);
            document.addEventListener('astro:before-swap', dispose, { once: true });
          } catch {
            fail();
          }
        })
        .catch(fail);
    };
    const probe = document.createElement('canvas');
    const supported = !!(probe.getContext('webgl2') || probe.getContext('webgl'));
    if (!supported) {
      fail();
    } else if ('requestIdleCallback' in window) {
      window.requestIdleCallback(start, { timeout: 900 });
    } else {
      setTimeout(start, 120);
    }
  }
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - 4rem);
    background-color: var(--koyori-paper);
  }

  .hero-fallback {
    display: none;
  }
  :global(html:not(.js)) .hero-fallback-narrow,
  .hero[data-gl='fallback'] .hero-fallback-narrow {
    display: block;
  }

  .hero-body {
    padding-top: 3rem;
  }
  .hero-text {
    max-width: 40rem;
  }
  .hero-title {
    color: var(--koyori-ink);
    font-size: clamp(2.125rem, 1.2rem + 4.2vw, 4rem);
  }
  .hero-title.display {
    font-size: clamp(2.5rem, 1.4rem + 4.4vw, 4.5rem);
    letter-spacing: -0.03em;
    line-height: 1.04;
  }
  .hero-lead {
    margin-top: 1.5rem;
    max-width: 36rem;
    font-size: 1.125rem;
    line-height: 1.875rem;
    color: var(--koyori-ink-2);
  }

  /* スマートフォン: 本文の下の帯を、右の外から左下へ紐が渡り、左端でほどけて下へ降りる */
  .hero-stage {
    position: relative;
    flex: 1;
    min-height: 17rem;
  }
  .anchor {
    position: absolute;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .anchor-start {
    left: 116%;
    top: 22%;
  }
  .anchor-split {
    left: calc(var(--gutter) + 0.75rem);
    top: 86%;
  }
  .hero-caption {
    position: absolute;
    left: var(--gutter);
    top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    max-width: 15rem;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--koyori-ink-2);
  }
  .hero-caption-word {
    font-family: var(--font-mincho);
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: var(--koyori-ink);
  }
  .hero-caption-meaning {
    flex-basis: 100%;
  }

  .hero-exits {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin-inline: auto;
    height: 1px;
  }
  .hero-exit {
    position: absolute;
    bottom: 0;
    left: calc(var(--gutter) + 0.75rem + var(--i) * 0.5rem);
    width: 1px;
    height: 1px;
  }

  @media (width >= 48rem) {
    /* デスクトップ: 見出しは左の静かな紙の上。紐は右上の外から入り、右寄りで紙を縫って、
       中央の下でほどけ、4 本がそれぞれプロダクトの列へ降りる */
    :global(html:not(.js)) .hero-fallback-narrow,
    .hero[data-gl='fallback'] .hero-fallback-narrow {
      display: none;
    }
    :global(html:not(.js)) .hero-fallback-wide,
    .hero[data-gl='fallback'] .hero-fallback-wide {
      display: block;
    }
    .hero-body {
      flex: 1;
      display: flex;
      align-items: center;
      padding-top: 4rem;
      padding-bottom: 10rem;
    }
    .hero-text {
      width: 58%;
      max-width: 46rem;
    }
    .hero-stage {
      position: absolute;
      inset: 0;
      min-height: 0;
      pointer-events: none;
    }
    .anchor-start {
      left: 108%;
      top: 4%;
    }
    .anchor-split {
      left: 60%;
      top: 74%;
    }
    .hero-caption {
      left: auto;
      right: var(--gutter);
      top: 54%;
      justify-content: flex-end;
      text-align: right;
      pointer-events: auto;
    }
    /* 出口はプロダクトの 4 列の、糸の印の真上 */
    .hero-exits {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 1rem;
      max-width: 84rem;
    }
    .hero-exit {
      position: relative;
      left: calc(1.5rem + 0.75rem);
    }
  }
</style>
