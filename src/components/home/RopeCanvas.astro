---
interface Props {
  hint: string;
}
const { hint } = Astro.props;
---

<div class="rope-box" aria-hidden="true">
  <canvas class="rope-canvas"></canvas>
  <p class="rope-hint label-mono">{hint}</p>
</div>

<script>
  import { mountRope } from '../../scripts/rope';

  const canvas = document.querySelector<HTMLCanvasElement>('.rope-canvas');
  if (canvas) {
    const styles = getComputedStyle(document.documentElement);
    const color = (name: string) => styles.getPropertyValue(name).trim();
    mountRope(canvas, [
      color('--koyori-lav'),
      color('--koyori-sage-deep'),
      color('--koyori-sage'),
      color('--koyori-lav-deep'),
    ]);
  }
</script>

<style>
  .rope-box {
    position: relative;
    min-height: 22rem;
  }
  .rope-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
    cursor: grab;
  }
  .rope-hint {
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  @media (hover: none) {
    .rope-hint {
      display: none;
    }
    .rope-canvas {
      cursor: default;
    }
  }
  @media (width < 48rem) {
    .rope-box {
      position: absolute;
      top: 0;
      right: 0;
      width: 5.5rem;
      height: 16rem;
      min-height: 0;
    }
    .rope-hint {
      display: none;
    }
  }
</style>
