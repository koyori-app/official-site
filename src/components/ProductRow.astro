---
import type { Locale } from '../i18n/ui';
import { localePath } from '../i18n/utils';
import type { Product } from '../data/products';
import ProductGlyph from './ProductGlyph.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  product: Product;
  lang: Locale;
  index: number;
  headingLevel?: 2 | 3;
}
const { product, lang, index, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = localePath(lang, `/products/${product.slug}`);
const tone = product.tone === 'sage' ? 'text-sage' : 'text-lav';
---

<a
  href={href}
  class="row-link group grid grid-cols-[2.5rem_1fr] items-center gap-x-5 gap-y-4 py-8 sm:grid-cols-[3.5rem_5rem_1fr_3.5rem] sm:gap-x-8 sm:py-10"
>
  <span class="label-mono self-start pt-2 sm:self-center sm:pt-0">
    {String(index).padStart(2, '0')}
  </span>
  <div class="order-3 col-span-2 sm:order-none sm:col-span-1">
    <ProductGlyph
      slug={product.slug}
      class:list={[
        'h-16 w-16 transition-transform duration-500 ease-soft group-hover:-rotate-6 group-hover:scale-110',
        tone,
      ]}
    />
  </div>
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      <Heading class="text-2xl font-semibold tracking-tight text-fg sm:text-3xl">
        {product.name}
      </Heading>
      <StatusBadge status={product.status} lang={lang} />
    </div>
    <p class="mt-2 max-w-xl text-fg-2">{product.tagline[lang]}</p>
    <p class="label-mono mt-4 normal-case tracking-normal">{product.stack.join(' · ')}</p>
  </div>
  <span
    class="hidden h-12 w-12 items-center justify-center rounded-full border border-line-strong text-fg-2 transition-[background-color,color,border-color,transform] duration-300 ease-soft group-hover:translate-x-1 group-hover:border-lav group-hover:bg-lav group-hover:text-on-lav sm:inline-flex"
    aria-hidden="true"
  >
    →
  </span>
</a>
