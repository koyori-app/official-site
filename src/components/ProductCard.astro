---
import type { Locale } from '../i18n/ui';
import { localePath } from '../i18n/utils';
import type { Product } from '../data/products';
import StrandMark from './StrandMark.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  product: Product;
  lang: Locale;
  headingLevel?: 2 | 3;
}
const { product, lang, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<a href={localePath(lang, `/products/${product.slug}`)} class="product-card">
  <StrandMark color={product.strand.color} />
  <Heading class="mt-5 text-xl leading-7 font-medium text-ink">{product.name}</Heading>
  <p class="mt-2 text-ink-2">{product.tagline[lang]}</p>
  <p class="meta mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-6">
    <StatusBadge status={product.status} lang={lang} />
    <span>{product.license}</span>
  </p>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    background-color: var(--koyori-paper-3);
    border: 1px solid var(--koyori-line);
    border-radius: 8px;
    text-decoration: none;
    line-height: 1.625rem;
    transition: border-color 150ms var(--koyori-ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .product-card:hover {
      border-color: var(--koyori-line-strong);
    }
  }
</style>
