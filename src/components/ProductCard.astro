---
import type { Locale } from '../i18n/ui';
import { localePath, t } from '../i18n/utils';
import type { Product } from '../data/products';
import StatusBadge from './StatusBadge.astro';

interface Props {
  product: Product;
  lang: Locale;
  headingLevel?: 2 | 3;
}
const { product, lang, headingLevel = 3 } = Astro.props;
const tr = t(lang);
const href = localePath(lang, `/products/${product.slug}`);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const stripe =
  product.tone === 'sage' ? 'from-accent-soft to-sage/40' : 'from-accent-subtle to-accent';
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface-raised transition-[border-color,box-shadow] duration-200 ease-out-soft hover:border-accent hover:shadow-[0_12px_32px_-16px_rgba(56,52,64,0.35)] focus-within:border-accent">
  <div class:list={['h-1.5 w-full bg-linear-to-r', stripe]} aria-hidden="true"></div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-3">
      <Heading class="text-xl font-bold tracking-tight text-ink">
        <a href={href} class="after:absolute after:inset-0 after:content-[''] focus:outline-none">
          {product.name}
        </a>
      </Heading>
      <StatusBadge status={product.status} lang={lang} />
    </div>
    <p class="mt-3 flex-1 text-ink-secondary">{product.tagline[lang]}</p>
    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={tr('product.stack')}>
      {product.stack.map((item) => (
        <li class="rounded-md bg-accent-subtle px-2 py-0.5 text-xs font-medium text-ink-secondary">
          {item}
        </li>
      ))}
    </ul>
    <span
      class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-link"
      aria-hidden="true"
    >
      {tr('product.detail')}
      <span class="transition-transform duration-200 ease-out-soft group-hover:translate-x-0.5">
        →
      </span>
    </span>
  </div>
</article>
