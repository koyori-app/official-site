---
import type { Locale } from '../i18n/ui';
import { localePath, t } from '../i18n/utils';
import type { Product } from '../data/products';
import ProductGlyph from './ProductGlyph.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  product: Product;
  lang: Locale;
}
const { product, lang } = Astro.props;
const tr = t(lang);
const href = localePath(lang, `/products/${product.slug}`);
const tone = product.tone === 'sage' ? 'text-sage' : 'text-lav';
---

<a
  href={href}
  class="group flex h-full flex-col rounded-2xl border border-line bg-bg-2 p-6 transition-[border-color,background-color] duration-300 ease-soft hover:border-line-strong hover:bg-bg-3"
>
  <div class="flex items-start justify-between gap-4">
    <ProductGlyph
      slug={product.slug}
      class:list={[
        'h-12 w-12 transition-transform duration-500 ease-soft group-hover:-rotate-6',
        tone,
      ]}
    />
    <StatusBadge status={product.status} lang={lang} />
  </div>
  <h3 class="mt-6 text-xl font-semibold tracking-tight text-fg">{product.name}</h3>
  <p class="mt-2 flex-1 text-sm text-fg-2">{product.tagline[lang]}</p>
  <span class="label-mono mt-6 text-lav-2">{tr('product.detail')} →</span>
</a>
