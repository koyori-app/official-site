---
import type { Product } from '../../data/products';

interface Props {
  product: Product;
  class?: string;
}
const { product, class: className } = Astro.props;
---

<div class:list={['motif', className]} aria-hidden="true">
  <canvas
    class="motif-canvas"
    data-motif={product.slug}
    data-strand={product.strand.color}
  ></canvas>
</div>

<script>
  import { mountMotif } from '../../scripts/motifs';
  document.querySelectorAll<HTMLCanvasElement>('.motif-canvas').forEach((canvas) => {
    mountMotif(canvas);
  });
</script>

<style>
  .motif {
    position: relative;
  }
  .motif-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
