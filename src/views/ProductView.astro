---
import type { Locale } from '../i18n/ui';
import { localePath, t } from '../i18n/utils';
import { products, type Product } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductGlyph from '../components/ProductGlyph.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ExternalIcon from '../components/ExternalIcon.astro';

interface Props {
  lang: Locale;
  product: Product;
}
const { lang, product } = Astro.props;
const tr = t(lang);
const others = products.filter((p) => p.slug !== product.slug);
const index = products.findIndex((p) => p.slug === product.slug) + 1;
const tone = product.tone === 'sage' ? 'text-sage' : 'text-lav';
const glowColor = product.tone === 'sage' ? 'rgba(159,194,169,0.28)' : 'rgba(196,181,223,0.3)';

/** `code` を <code> にする */
function inlineCode(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(
      /`([^`]+)`/g,
      '<code class="rounded bg-bg-3 px-1.5 py-0.5 font-mono text-[0.85em] text-lav-2">$1</code>',
    );
}
---

<BaseLayout lang={lang} title={product.name} description={product.tagline[lang]}>
  <section class="relative isolate overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style={`background: radial-gradient(45% 60% at 80% 40%, ${glowColor}, transparent 70%);`}
      aria-hidden="true"
    ></div>
    <div class="container-site grid items-center gap-12 pt-20 pb-16 sm:pt-28 lg:grid-cols-[1fr_20rem]">
      <div>
        <nav aria-label="Breadcrumb" class="label-mono">
          <ol class="flex flex-wrap items-center gap-3">
            <li>
              <a href={localePath(lang, '/products/')} class="transition-colors hover:text-fg">
                {tr('products.title')}
              </a>
            </li>
            <li aria-hidden="true" class="text-sage">
              /
            </li>
            <li aria-current="page">{String(index).padStart(2, '0')}</li>
          </ol>
        </nav>
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          <h1 class="display text-5xl text-fg sm:text-7xl">{product.name}</h1>
          <StatusBadge status={product.status} lang={lang} />
        </div>
        <p
          class:list={[
            'mt-6 max-w-2xl text-2xl text-fg-2 sm:text-3xl',
            lang === 'ja' ? 'display-ja font-normal' : 'tracking-tight',
          ]}
        >
          {product.tagline[lang]}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={product.repo} rel="noopener" class="btn btn-primary">
            {tr('product.repo')}
            <ExternalIcon />
          </a>
          {product.links.map((link) => (
            <a href={link.href} rel="noopener" class="btn btn-ghost">
              {link.label[lang]}
              <ExternalIcon />
            </a>
          ))}
        </div>
      </div>
      <div class="hidden justify-center lg:flex">
        <ProductGlyph
          slug={product.slug}
          class:list={['h-64 w-64 drop-shadow-[0_0_40px_rgba(196,181,223,0.25)]', tone]}
        />
      </div>
    </div>
  </section>

  <section class="container-site grid gap-14 py-10 lg:grid-cols-[1fr_18rem] lg:gap-20">
    <div>
      <p class="max-w-prose text-lg text-fg-2" set:html={inlineCode(product.description[lang])} />
      <h2 class="label-mono mt-16">{tr('product.features')}</h2>
      <ol class="mt-4">
        {product.features[lang].map((feature, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-t border-line py-5 text-fg-2 last:border-b">
            <span class="label-mono pt-1 text-sage">{String(i + 1).padStart(2, '0')}</span>
            <span set:html={inlineCode(feature)} />
          </li>
        ))}
      </ol>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <dl class="rounded-2xl border border-line bg-bg-2 p-6">
        <dt class="label-mono">{tr('product.stack')}</dt>
        <dd class="mt-3">
          <ul class="flex flex-wrap gap-1.5">
            {product.stack.map((item) => (
              <li class="rounded-full border border-line px-2.5 py-0.5 font-mono text-xs text-fg-2">
                {item}
              </li>
            ))}
          </ul>
        </dd>
        <dt class="label-mono mt-7">{tr('product.license')}</dt>
        <dd class="mt-2 font-mono text-sm text-fg">{product.license}</dd>
        <dt class="label-mono mt-7">{tr('product.links')}</dt>
        <dd class="mt-2">
          <ul class="flex flex-col gap-2 text-sm">
            <li>
              <a
                href={product.repo}
                rel="noopener"
                class="inline-flex items-center gap-1.5 text-lav-2 hover:underline"
              >
                GitHub
                <ExternalIcon />
              </a>
            </li>
            {product.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  rel="noopener"
                  class="inline-flex items-center gap-1.5 text-lav-2 hover:underline"
                >
                  {link.label[lang]}
                  <ExternalIcon />
                </a>
              </li>
            ))}
          </ul>
        </dd>
      </dl>
    </aside>
  </section>

  <section class="container-site pt-16" aria-labelledby="product-others">
    <h2 id="product-others" class="label-mono">
      {tr('product.others')}
    </h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {others.map((p) => (
        <li>
          <ProductCard product={p} lang={lang} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
