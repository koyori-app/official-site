---
import type { Locale } from '../i18n/ui';
import { localePath, t } from '../i18n/utils';
import { products, type Product } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductMotif from '../components/product/ProductMotif.astro';
import StatusBadge from '../components/StatusBadge.astro';
import StrandMark from '../components/StrandMark.astro';
import Icon from '../components/Icon.astro';

interface Props {
  lang: Locale;
  product: Product;
}
const { lang, product } = Astro.props;
const tr = t(lang);
const others = products.filter((p) => p.slug !== product.slug);
// ヒーローの操作は主 1 つ＋副 1 つまで。リンクが複数あるプロダクトは右の「リンク」にまとめる
const secondary = product.links.length === 1 ? product.links[0] : undefined;

/** `code` を <code> にする */
function inlineCode(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/`([^`]+)`/g, '<code class="code-inline">$1</code>');
}
---

<BaseLayout lang={lang} title={product.name} description={product.tagline[lang]}>
  <section class="container-site product-hero">
    <div class="product-hero-text">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-3">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a
              href={localePath(lang, '/products/')}
              class="inline-flex min-h-10 items-center transition-colors duration-150 hover:text-ink"
            >
              {tr('products.title')}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink-2">
            {product.name}
          </li>
        </ol>
      </nav>

      <StrandMark color={product.strand.color} class="mt-10" />
      <h1 class="product-title display mt-5 text-ink">{product.name}</h1>
      <p class="mt-5 max-w-[32rem] text-xl leading-8 text-ink-2">{product.tagline[lang]}</p>

      <p class="meta mt-6 flex flex-wrap items-center gap-x-4 gap-y-1">
        <StatusBadge status={product.status} lang={lang} />
        <span>{product.license}</span>
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href={product.repo} rel="noopener" class="btn btn-primary">
          {tr('product.repo')}
          <Icon name="arrow-up-right" />
        </a>
        {secondary && (
          <a href={secondary.href} rel="noopener" class="btn btn-secondary">
            {secondary.label[lang]}
            <Icon name="arrow-up-right" />
          </a>
        )}
      </div>
    </div>
    <ProductMotif product={product} class="product-motif" />
  </section>

  <section class="container-site grid gap-16 pt-16 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-24">
    <div>
      <p
        class="max-w-[40em] text-lg leading-8 text-ink-2"
        set:html={inlineCode(product.description[lang])}
      />
      <h2 class="mt-16 text-lg leading-7 font-medium text-ink">{tr('product.features')}</h2>
      <ul class="mt-4">
        {product.features[lang].map((feature) => (
          <li class="feature text-ink" set:html={inlineCode(feature)} />
        ))}
      </ul>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <dl class="border-t border-line-strong pt-6">
        <dt class="text-sm text-ink-3">{tr('product.stack')}</dt>
        <dd class="mt-2">
          <ul class="flex flex-wrap gap-2">
            {product.stack.map((item) => (
              <li class="rounded border border-line bg-paper-3 px-2 py-0.5 font-mono text-[0.8125rem] text-ink">
                {item}
              </li>
            ))}
          </ul>
        </dd>
        <dt class="mt-6 text-sm text-ink-3">{tr('product.license')}</dt>
        <dd class="mt-2 font-mono text-[0.8125rem] text-ink">{product.license}</dd>
        <dt class="mt-6 text-sm text-ink-3">{tr('product.links')}</dt>
        <dd class="mt-1">
          <ul class="flex flex-col">
            <li>
              <a
                href={product.repo}
                rel="noopener"
                class="link inline-flex min-h-10 items-center gap-1"
              >
                GitHub
                <Icon name="arrow-up-right" />
              </a>
            </li>
            {product.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  rel="noopener"
                  class="link inline-flex min-h-10 items-center gap-1"
                >
                  {link.label[lang]}
                  <Icon name="arrow-up-right" />
                </a>
              </li>
            ))}
          </ul>
        </dd>
      </dl>
    </aside>
  </section>

  <section class="container-site pt-24" aria-labelledby="product-others">
    <h2 id="product-others" class="text-lg leading-7 font-medium text-ink">
      {tr('product.others')}
    </h2>
    <ul class="mt-6 grid gap-4 md:grid-cols-3">
      {others.map((p) => (
        <li>
          <ProductCard product={p} lang={lang} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .product-hero {
    display: grid;
    gap: 3rem;
    padding-top: 1.5rem;
  }
  .product-title {
    font-size: clamp(2.75rem, 1.8rem + 3.4vw, 4.5rem);
    letter-spacing: -0.03em;
  }
  :global(.product-motif) {
    height: 16rem;
    border: 1px solid var(--koyori-line);
    border-radius: 8px;
    background-color: var(--koyori-paper-3);
    overflow: hidden;
  }
  .feature {
    padding-block: 1rem;
    border-top: 1px solid var(--koyori-line-strong);
    line-height: 1.75rem;
  }
  .feature:last-child {
    border-bottom: 1px solid var(--koyori-line-strong);
  }

  @media (width >= 64rem) {
    .product-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 4rem;
      min-height: calc(100svh - 12rem);
      padding-top: 2rem;
    }
    :global(.product-motif) {
      height: 30rem;
    }
  }
</style>
