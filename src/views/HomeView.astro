---
import type { Locale } from '../i18n/ui';
import { formatDate, isoDate, localePath, t } from '../i18n/utils';
import { githubOrg, products } from '../data/products';
import { getNews, newsSlug } from '../lib/news';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);
const display = lang === 'ja' ? 'display-ja' : 'display';

const principles = (['oss', 'selfhost', 'consistent', 'rust'] as const).map((key) => ({
  title: tr(`principles.${key}.title`),
  body: tr(`principles.${key}.body`),
}));

const news = (await getNews(lang)).slice(0, 3);
---

<BaseLayout lang={lang}>
  <HomeHero lang={lang} />

  <section class="container-site pt-16" aria-labelledby="home-products">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
      <div>
        <h2 id="home-products" class:list={['section-title text-ink', display]}>
          {tr('products.title')}
        </h2>
        <p class="mt-3 max-w-xl text-lg leading-7 text-ink-2">{tr('products.lead')}</p>
      </div>
      <a
        href={localePath(lang, '/products/')}
        class="inline-flex min-h-10 items-center gap-1 text-ink-2 transition-colors duration-150 hover:text-ink"
      >
        {tr('products.viewAll')}
        <Icon name="arrow-right" />
      </a>
    </div>
    <ul class="product-grid mt-10">
      {products.map((product) => (
        <li>
          <ProductCard product={product} lang={lang} />
        </li>
      ))}
    </ul>
  </section>

  <section class="container-site pt-32" aria-labelledby="home-principles">
    <div class="grid gap-x-16 gap-y-10 border-t border-line-strong pt-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div>
        <h2 id="home-principles" class:list={['section-title text-ink', display]}>
          {tr('principles.title')}
        </h2>
        <p class="mt-3 max-w-xs text-lg leading-7 text-ink-2">{tr('principles.lead')}</p>
      </div>
      <ul class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {principles.map((item) => (
          <li>
            <h3 class="text-lg leading-7 font-medium text-ink">{item.title}</h3>
            <p class="mt-2 text-ink-2">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-site pt-32" aria-labelledby="home-news">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
      <h2 id="home-news" class:list={['section-title text-ink', display]}>
        {tr('news.title')}
      </h2>
      <a
        href={localePath(lang, '/news/')}
        class="inline-flex min-h-10 items-center gap-1 text-ink-2 transition-colors duration-150 hover:text-ink"
      >
        {tr('news.viewAll')}
        <Icon name="arrow-right" />
      </a>
    </div>
    {news.length === 0 ? (
      <p class="mt-8 text-ink-2">{tr('news.empty')}</p>
    ) : (
      <ul class="mt-8">
        {news.map((entry) => (
          <li>
            <a
              href={localePath(lang, `/news/${newsSlug(entry)}`)}
              class="row-link grid gap-1 py-5 sm:grid-cols-[12rem_minmax(0,1fr)_auto] sm:items-baseline sm:gap-8 sm:px-2"
            >
              <time datetime={isoDate(entry.data.date)} class="meta">
                {formatDate(entry.data.date, lang)}
              </time>
              <span class="text-lg leading-7 text-ink">{entry.data.title}</span>
              <Icon name="arrow-right" class="hidden h-4 w-4 self-center text-ink-3 sm:block" />
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="container-site pt-32" aria-labelledby="home-cta">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-8 rounded-lg border border-line bg-paper-3 p-8 sm:p-12">
      <div>
        <h2 id="home-cta" class:list={['section-title max-w-[18em] text-ink', display]}>
          {tr('cta.title.home')}
        </h2>
        <p class="mt-3 max-w-xl text-lg leading-7 text-ink-2">{tr('cta.body.home')}</p>
      </div>
      <a href={githubOrg} rel="noopener" class="btn btn-primary">
        {tr('cta.button')}
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </section>
</BaseLayout>
