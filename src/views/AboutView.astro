---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { githubOrg } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);

const sections = (['what', 'how', 'contribute'] as const).map((key) => ({
  title: tr(`about.${key}.title`),
  body: tr(`about.${key}.body`),
}));
---

<BaseLayout lang={lang} title={tr('about.title')} description={tr('about.pageDescription')}>
  <section class="container-site py-16 sm:py-20">
    <div class="max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">{tr('about.title')}</h1>
      <p class="mt-4 text-xl text-ink-secondary">{tr('about.lead')}</p>
    </div>
    <div class="mt-14 grid gap-10 lg:grid-cols-3">
      {sections.map((section, i) => (
        <section class="relative rounded-2xl border border-border bg-surface-raised p-6 sm:p-8">
          <span
            class:list={[
              'inline-flex h-9 w-9 items-center justify-center rounded-lg text-sm font-bold',
              i % 2 === 0 ? 'bg-accent text-on-accent' : 'bg-accent-soft text-ink',
            ]}
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <h2 class="mt-4 text-xl font-bold text-ink">{section.title}</h2>
          <p class="mt-3 text-ink-secondary">{section.body}</p>
        </section>
      ))}
    </div>
    <div class="mt-14 rounded-2xl bg-accent-subtle p-8 text-center">
      <h2 class="text-2xl font-bold text-ink">{tr('cta.title')}</h2>
      <p class="mt-2 text-ink-secondary">{tr('cta.body')}</p>
      <a href={githubOrg} rel="noopener" class="btn btn-primary mt-6">
        {tr('cta.button')}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
