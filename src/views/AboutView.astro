---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { githubOrg } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);
const display = lang === 'ja' ? 'display-ja' : 'display';

const sections = (['what', 'how', 'contribute'] as const).map((key) => ({
  title: tr(`about.${key}.title`),
  body: tr(`about.${key}.body`),
}));
---

<BaseLayout lang={lang} title={tr('about.title')} description={tr('about.pageDescription')}>
  <section class="container-site pt-16 sm:pt-24">
    <h1 class:list={['page-title text-ink', display]}>{tr('about.title')}</h1>
    <p class="mt-4 max-w-2xl text-xl leading-8 text-ink-2">{tr('about.lead')}</p>
    <dl class="mt-12 max-w-md border-t border-line-strong pt-6">
      <dt class="flex items-baseline gap-3">
        <span class="font-mincho text-2xl leading-8 text-ink" lang="ja">
          紙縒り
        </span>
        <span class="text-sm text-ink-3">{tr('hero.reading')}</span>
      </dt>
      <dd class="mt-2 text-ink-2">{tr('footer.meaning')}</dd>
    </dl>
  </section>

  <section class="container-site mt-16">
    <ul>
      {sections.map((section) => (
        <li class="about-item">
          <h2 class="text-lg leading-7 font-medium text-ink">{section.title}</h2>
          <p class="max-w-2xl text-ink-2">{section.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-site mt-24">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-8 rounded-lg border border-line bg-paper-3 p-8 sm:p-12">
      <div>
        <h2 class:list={['section-title text-ink', display]}>{tr('cta.title')}</h2>
        <p class="mt-3 max-w-lg text-lg leading-7 text-ink-2">{tr('cta.body')}</p>
      </div>
      <a href={githubOrg} rel="noopener" class="btn btn-primary">
        {tr('cta.button')}
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-item {
    display: grid;
    gap: 0.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--koyori-line-strong);
  }
  .about-item:last-child {
    border-bottom: 1px solid var(--koyori-line-strong);
  }
  @media (width >= 64rem) {
    .about-item {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 4rem;
    }
  }
</style>
