---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { githubOrg } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);

const sections = (['what', 'how', 'contribute'] as const).map((key) => ({
  title: tr(`about.${key}.title`),
  body: tr(`about.${key}.body`),
}));
---

<BaseLayout lang={lang} title={tr('about.title')} description={tr('about.pageDescription')}>
  <section class="container-site pt-20 pb-12 sm:pt-28">
    <p class="label-mono">About</p>
    <h1
      class:list={[
        'mt-4 max-w-4xl text-5xl text-fg sm:text-7xl',
        lang === 'ja' ? 'display-ja' : 'display',
      ]}
    >
      {tr('about.title')}
    </h1>
    <p class="mt-6 max-w-2xl text-xl text-fg-2">{tr('about.lead')}</p>

    <ol class="mt-20">
      {sections.map((section, i) => (
        <li class="grid gap-4 border-t border-line py-10 last:border-b sm:grid-cols-[6rem_1fr] sm:gap-10 lg:grid-cols-[6rem_18rem_1fr]">
          <span class="label-mono pt-1.5 text-sage">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="text-2xl font-semibold tracking-tight text-fg">{section.title}</h2>
          <p class="max-w-2xl text-fg-2 lg:col-start-3">{section.body}</p>
        </li>
      ))}
    </ol>

    <div class="mt-20 flex flex-wrap items-center justify-between gap-6 rounded-3xl border border-line bg-bg-2 p-8 sm:p-10">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-fg">{tr('cta.title')}</h2>
        <p class="mt-2 text-fg-2">{tr('cta.body')}</p>
      </div>
      <a href={githubOrg} rel="noopener" class="btn btn-primary">
        {tr('cta.button')}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
