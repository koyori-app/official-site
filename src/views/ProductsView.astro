---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { products } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<BaseLayout lang={lang} title={tr('products.title')} description={tr('products.pageDescription')}>
  <section class="container-site py-16 sm:py-20">
    <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">{tr('products.title')}</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-secondary">{tr('products.lead')}</p>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
      {products.map((product) => (
        <li>
          <ProductCard product={product} lang={lang} headingLevel={2} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
