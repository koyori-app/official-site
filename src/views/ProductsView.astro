---
import type { Locale } from '../i18n/ui';
import { localePath, t } from '../i18n/utils';
import { products } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import StrandMark from '../components/StrandMark.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);
const display = lang === 'ja' ? 'display-ja' : 'display';
---

<BaseLayout lang={lang} title={tr('products.title')} description={tr('products.pageDescription')}>
  <section class="container-site pt-16 sm:pt-24">
    <h1 class:list={['page-title text-ink', display]}>{tr('products.title')}</h1>
    <p class="mt-4 max-w-xl text-lg leading-7 text-ink-2">{tr('products.lead')}</p>
    <ul class="product-grid mt-12">
      {products.map((product) => (
        <li>
          <ProductCard product={product} lang={lang} headingLevel={2} />
        </li>
      ))}
    </ul>
  </section>

  <section class="container-site pt-24" aria-labelledby="products-glance">
    <h2 id="products-glance" class:list={['section-title text-ink', display]}>
      {tr('products.glance')}
    </h2>
    <div class="relative mt-8 overflow-x-auto">
      <table class="glance w-full min-w-[40rem] text-left">
        <thead>
          <tr>
            <th scope="col">{tr('nav.products')}</th>
            <th scope="col">{tr('product.stack')}</th>
            <th scope="col">{tr('product.license')}</th>
            <th scope="col">{tr('product.status')}</th>
          </tr>
        </thead>
        <tbody>
          {products.map((product) => (
            <tr>
              <th scope="row">
                <a
                  href={localePath(lang, `/products/${product.slug}`)}
                  class="inline-flex min-h-10 items-center gap-3 font-medium whitespace-nowrap text-ink underline-offset-4 hover:underline"
                >
                  <StrandMark color={product.strand.color} />
                  {product.name}
                </a>
              </th>
              <td class="font-mono text-[0.8125rem] text-ink-2">{product.stack.join(' · ')}</td>
              <td class="font-mono text-[0.8125rem] text-ink-2">{product.license}</td>
              <td class="text-sm text-ink-2">
                <StatusBadge status={product.status} lang={lang} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style>
  .glance th,
  .glance td {
    padding: 0.75rem 1.5rem 0.75rem 0;
    border-bottom: 1px solid var(--koyori-line-strong);
    vertical-align: middle;
  }
  .glance thead th {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--koyori-ink-3);
    padding-block: 0.5rem;
  }
</style>
