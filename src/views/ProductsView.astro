---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { products } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductRow from '../components/ProductRow.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<BaseLayout lang={lang} title={tr('products.title')} description={tr('products.pageDescription')}>
  <section class="container-site pt-20 pb-12 sm:pt-28">
    <p class="label-mono">Products</p>
    <h1
      class:list={['mt-4 text-5xl text-fg sm:text-7xl', lang === 'ja' ? 'display-ja' : 'display']}
    >
      {tr('products.title')}
    </h1>
    <p class="mt-6 max-w-xl text-lg text-fg-2">{tr('products.lead')}</p>
    <ol class="mt-16">
      {products.map((product, i) => (
        <li>
          <ProductRow product={product} lang={lang} index={i + 1} headingLevel={2} />
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
