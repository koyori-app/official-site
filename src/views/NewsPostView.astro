---
import { render } from 'astro:content';
import type { Locale } from '../i18n/ui';
import { formatDate, isoDate, localePath, t } from '../i18n/utils';
import { findTranslations, newsSlug, type NewsEntry } from '../lib/news';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

interface Props {
  lang: Locale;
  entry: NewsEntry;
}
const { lang, entry } = Astro.props;
const tr = t(lang);
const { Content } = await render(entry);

const translations = await findTranslations(entry);
const alternates: Partial<Record<Locale, string>> = {
  [lang]: localePath(lang, `/news/${newsSlug(entry)}`),
};
for (const other of translations) {
  alternates[other.data.lang] = localePath(other.data.lang, `/news/${newsSlug(other)}`);
}
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  alternates={alternates}
  ogType="article"
>
  <article class="container-site pt-12 sm:pt-16">
    <a
      href={localePath(lang, '/news/')}
      class="inline-flex min-h-10 items-center gap-1 text-sm text-ink-2 transition-colors duration-150 hover:text-ink"
    >
      <Icon name="arrow-left" />
      {tr('news.back')}
    </a>
    <div class="mt-8 grid gap-8 lg:grid-cols-[12rem_minmax(0,44rem)] lg:gap-16">
      <aside class="flex flex-wrap items-center gap-x-6 gap-y-1 lg:flex-col lg:items-start lg:pt-4">
        <time datetime={isoDate(entry.data.date)} class="meta">
          {formatDate(entry.data.date, lang)}
        </time>
        {translations.map((other) => (
          <a
            href={alternates[other.data.lang]}
            hreflang={other.data.lang}
            lang={other.data.lang}
            class="link inline-flex min-h-10 items-center text-sm"
          >
            {tr('news.alt')}
          </a>
        ))}
      </aside>
      <div>
        <header>
          <h1
            class:list={[
              'text-[clamp(2rem,1.4rem+1.8vw,2.75rem)] text-ink',
              lang === 'ja' ? 'display-ja' : 'display',
            ]}
          >
            {entry.data.title}
          </h1>
          <p class="mt-4 text-lg leading-8 text-ink-2">{entry.data.description}</p>
        </header>
        <div class="prose mt-10 border-t border-line-strong pt-8 text-ink-2">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
