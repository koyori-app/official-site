---
import type { Locale } from '../i18n/ui';
import { formatDate, isoDate, localePath, t } from '../i18n/utils';
import { getNews, newsSlug } from '../lib/news';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);
const news = await getNews(lang);
---

<BaseLayout lang={lang} title={tr('news.title')} description={tr('news.pageDescription')}>
  <section class="container-site py-16 sm:py-20">
    <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">{tr('news.title')}</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-secondary">{tr('news.lead')}</p>
    {news.length === 0 ? (
      <p class="mt-12 text-ink-secondary">{tr('news.empty')}</p>
    ) : (
      <ul class="mt-12 grid gap-4">
        {news.map((entry) => (
          <li>
            <a
              href={localePath(lang, `/news/${newsSlug(entry)}`)}
              class="group block rounded-2xl border border-border bg-surface-raised p-6 transition-colors duration-200 hover:border-accent"
            >
              <time datetime={isoDate(entry.data.date)} class="text-sm text-ink-muted tabular-nums">
                {formatDate(entry.data.date, lang)}
              </time>
              <h2 class="mt-2 text-xl font-bold text-ink underline-offset-4 group-hover:underline">
                {entry.data.title}
              </h2>
              <p class="mt-2 text-ink-secondary">{entry.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
