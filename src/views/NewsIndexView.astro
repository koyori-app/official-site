---
import type { Locale } from '../i18n/ui';
import { formatDate, isoDate, localePath, t } from '../i18n/utils';
import { getNews, newsSlug } from '../lib/news';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);
const news = await getNews(lang);
const display = lang === 'ja' ? 'display-ja' : 'display';
---

<BaseLayout lang={lang} title={tr('news.title')} description={tr('news.pageDescription')}>
  <section class="container-site pt-16 pb-12 sm:pt-24">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end">
      <div>
        <p class="label-mono">
          <span class="text-sage-ink">—</span> News
        </p>
        <h1 class:list={['mt-4 text-[clamp(3.5rem,11vw,9rem)] text-ink', display]}>
          {tr('news.title')}
        </h1>
      </div>
      <p class="max-w-md text-lg text-ink-2 lg:justify-self-end">{tr('news.lead')}</p>
    </div>
    {news.length === 0 ? (
      <p class="mt-16 text-ink-2">{tr('news.empty')}</p>
    ) : (
      <ul class="mt-16">
        {news.map((entry) => (
          <li>
            <a
              href={localePath(lang, `/news/${newsSlug(entry)}`)}
              class="row-link group grid gap-3 py-9 sm:grid-cols-[12rem_minmax(0,1fr)_auto] sm:gap-10"
            >
              <time datetime={isoDate(entry.data.date)} class="label-mono pt-2">
                {formatDate(entry.data.date, lang)}
              </time>
              <div>
                <h2
                  class:list={[
                    'text-2xl text-ink sm:text-[2rem]',
                    lang === 'ja' ? 'display-ja' : 'font-serif leading-tight',
                  ]}
                >
                  {entry.data.title}
                </h2>
                <p class="mt-3 max-w-2xl text-ink-2">{entry.data.description}</p>
              </div>
              <span
                class="hidden pt-2 font-mono text-ink-3 transition-transform duration-300 ease-soft group-hover:translate-x-1 sm:block"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
