---
import type { Locale } from '../i18n/ui';
import { formatDate, isoDate, localePath, t } from '../i18n/utils';
import { getNews, newsSlug } from '../lib/news';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);
const news = await getNews(lang);
---

<BaseLayout lang={lang} title={tr('news.title')} description={tr('news.pageDescription')}>
  <section class="container-site pt-20 pb-12 sm:pt-28">
    <p class="label-mono">News</p>
    <h1
      class:list={['mt-4 text-5xl text-fg sm:text-7xl', lang === 'ja' ? 'display-ja' : 'display']}
    >
      {tr('news.title')}
    </h1>
    <p class="mt-6 max-w-xl text-lg text-fg-2">{tr('news.lead')}</p>
    {news.length === 0 ? (
      <p class="mt-16 text-fg-2">{tr('news.empty')}</p>
    ) : (
      <ul class="mt-16">
        {news.map((entry) => (
          <li>
            <a
              href={localePath(lang, `/news/${newsSlug(entry)}`)}
              class="row-link group grid gap-3 py-8 sm:grid-cols-[10rem_1fr] sm:gap-10"
            >
              <time datetime={isoDate(entry.data.date)} class="label-mono pt-1.5">
                {formatDate(entry.data.date, lang)}
              </time>
              <div>
                <h2 class="text-2xl font-semibold tracking-tight text-fg transition-colors group-hover:text-lav-2">
                  {entry.data.title}
                </h2>
                <p class="mt-2 max-w-2xl text-fg-2">{entry.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
